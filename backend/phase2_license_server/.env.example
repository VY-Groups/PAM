# Copy this file to .env and adjust. Every value is optional.

# SQLite file (or other SQLAlchemy URI) holding issued licenses + revocation list.
#LICENSE_DATABASE_URI=sqlite:///C:/path/to/licenses.db

# Signing key pair. Defaults to the Phase 1 keys in the repository root.
# Relative paths are resolved against backend/phase2_license_server/.
#LICENSE_PRIVATE_KEY_PATH=../../license_private_key.pem
#LICENSE_PUBLIC_KEY_PATH=../../license_public_key.pem

# Optional second algorithm (created on first Ed25519 issuance when
# LICENSE_AUTOGENERATE_KEYS=1). Same relative-path rules as above.
#LICENSE_ED25519_PRIVATE_KEY_PATH=../../license_ed25519_private.pem
#LICENSE_ED25519_PUBLIC_KEY_PATH=../../license_ed25519_public.pem

# Set to 1 to let the server generate a missing key pair (development only).
#LICENSE_AUTOGENERATE_KEYS=0

# Bearer token required by issue/revoke/restore/usage/download endpoints.
# Leave unset to run in open dev mode (responses carry X-Auth-Mode: open).
#LICENSE_ADMIN_TOKEN=change-me

# Flask session signing key. Set a stable random value in production.
#LICENSE_SECRET_KEY=

# Bind address.
#LICENSE_SERVER_HOST=127.0.0.1
#LICENSE_SERVER_PORT=5000
#LICENSE_SERVER_DEBUG=0

# Default trial length when an issued trial license omits trial_days.
#LICENSE_DEFAULT_TRIAL_DAYS=30
